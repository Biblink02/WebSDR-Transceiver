{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "&/*": [
        "./app/*"
      ],
      "~/*": [
        "./resources/*"
      ]
    },
    "outDir": "public/build/assets",
    "skipLibCheck": true
  },
  "include": [
    "./app/**/*.ts",
    "./scripts/**/*.ts",
    "./app/**/*.d.ts",
    "./app/**/*.vue",
    "./vite.config.ts"
  ],
  "exclude": [
    "./node_modules",
    "./public",
    "**/*.test.ts"
  ]
}
